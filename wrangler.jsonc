// Cortex Hub Booking on Cloudflare Workers via @opennextjs/cloudflare (Vercel Hobby disabled, Oct 24 2026).
// Secrets via `wrangler secret` only (CI uploads them). PRODUCTION from day one.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // Interim address (Oct 24 2026). Portfolio address on the CreativelyNanda zone.
  "routes": [{ "pattern": "cortex.creativelynanda.co.za", "custom_domain": true }],
  "placement": { "mode": "smart" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "cortex-hub" }],
  "r2_buckets": [{ "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "cortex-hub-inc-cache" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] }]
}
